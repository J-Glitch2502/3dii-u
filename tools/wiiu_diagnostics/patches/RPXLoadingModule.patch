+#include "DevBundlePaths.h"
+#include <cassert>
+int main() {
+    using namespace dev_bundle;
+    assert(release_root("wiiu/apps/Kirby Triple Deluxe.wuhb", "20261118-1") == "wiiu/apps/Kirby Triple Deluxe.wuhb.dev/builds/20261118-1");
+    assert(release_root("wiiu/apps/Other/App.wuhb", "v2") == "wiiu/apps/Other/App.wuhb.dev/builds/v2");
+    for (const auto *bad : {"", "../bad", "/root", "a/b", "a\\b", "a:b", "a\nb", ".."}) assert(!valid_release(bad));
+    assert(!valid_release(std::string(65, 'a')));
+    for (const auto *bad : {"wiiu/apps/../bad.wuhb", "wiiu/apps//bad.wuhb", "/wiiu/apps/a.wuhb", "wiiu/apps/a.rpx", "wiiu/apps/a:b.wuhb", "wiiu/apps/a\\b.wuhb"}) assert(!valid_bundle(bad));
