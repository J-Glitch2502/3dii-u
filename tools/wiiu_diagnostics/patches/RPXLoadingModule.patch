diff --git a/src/DevBundlePaths.h b/src/DevBundlePaths.h
new file mode 100644
index 0000000..f34de3f
--- /dev/null
+++ b/src/DevBundlePaths.h
@@ -0,0 +1,28 @@
+#pragma once
+#include <string>
+
+namespace dev_bundle {
+inline bool valid_bundle(const std::string &path) {
+    if (!path.starts_with("wiiu/apps/") || !path.ends_with(".wuhb")) return false;
+    size_t begin = 0;
+    while (begin < path.size()) {
+        size_t end = path.find('/', begin);
+        if (end == std::string::npos) end = path.size();
+        const auto part = path.substr(begin, end - begin);
+        if (part.empty() || part == "." || part == "..") return false;
+        for (unsigned char c : part) if (c < 32 || c == 127 || c == ':' || c == '\\') return false;
+        begin = end + 1;
+    }
+    return true;
+}
+inline bool valid_release(const std::string &release) {
+    if (release.empty() || release.size() > 64) return false;
+    for (unsigned char c : release)
+        if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_')) return false;
+    return true;
+}
+inline std::string release_root(const std::string &bundle, const std::string &release) {
+    if (!valid_bundle(bundle) || !valid_release(release)) return {};
+    return bundle + ".dev/builds/" + release;
+}
+} // namespace dev_bundle
