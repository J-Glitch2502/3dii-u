+// The companion directory belongs to the full bundle path, so equal names in
+// different app directories cannot collide. active.txt is published only after
+// every file of an immutable release has been uploaded and verified.
+static std::string devExecutableOverride(const char *bundlePath) {
+    if (!bundlePath || !dev_bundle::valid_bundle(bundlePath)) return {};
+    const std::string active = std::string("fs:/vol/external01/") + bundlePath + ".dev/active.txt";
+    std::string selected;
+    FILE *manifest = fopen(active.c_str(), "rb");
+    if (manifest) {
+        char text[67];
+        const size_t n = fread(text, 1, sizeof(text), manifest);
+        const bool good = !ferror(manifest) && n < sizeof(text);
+        fclose(manifest);
+        std::string release(text, n);
+        while (!release.empty() && (release.back() == '\n' || release.back() == '\r')) release.pop_back();
+        selected = good ? dev_bundle::release_root(bundlePath, release) : std::string();
+        if (selected.empty()) {
+            OSReport("[homebrew dev] Invalid active.txt for %s; using bundle\n", bundlePath);
+            return {};
+        }
+        selected += "/root.rpx";
+    } else {
+        if (errno != ENOENT) return {};
+        // Compatibility with existing development installs. New titles never
+        // need an entry here: the companion directory above works for any WUHB.
+        const char *overridePath;
+        if (strcmp(bundlePath, "wiiu/apps/Brain Age Dev.wuhb") == 0) {
+            overridePath = "3dii-u/dev/brain-age/g_asre.rpx";
+        } else if (strcmp(bundlePath, "wiiu/apps/Mario Party Island Tour.wuhb") == 0) {
+            overridePath = "3dii-u/dev/island-tour/g_atse.rpx";
+        } else if (strcmp(bundlePath, "wiiu/apps/Mario Party Star Rush.wuhb") == 0) {
+            overridePath = "3dii-u/dev/star-rush/g_baae.rpx";
+        } else if (strcmp(bundlePath, "wiiu/apps/Mario Party The Top 100.wuhb") == 0) {
+            overridePath = "3dii-u/dev/top-100/g_bhre.rpx";
+        } else {
+            return {};
+        }
+        selected = overridePath;
+    }
+    MochaRPXLoadInfo request {};
+    if (selected.size() >= sizeof(request.path)) return {};
+    const std::string fsPath = "fs:/vol/external01/" + selected;
+    struct stat info {};
+    if (stat(fsPath.c_str(), &info) != 0 || !S_ISREG(info.st_mode) || info.st_size < 52) return {};
+    FILE *file = fopen(fsPath.c_str(), "rb");
+    if (!file) return {};
+    uint8_t header[52];
+    const size_t read = fread(header, 1, sizeof(header), file);
+    fclose(file);
+    constexpr uint8_t elfPrefix[] = {0x7f, 'E', 'L', 'F', 1, 2, 1, 0xca, 0xfe};
+    constexpr uint8_t rpxTypeAndMachine[] = {0xfe, 0x01, 0, 0x14};
+    if (read != sizeof(header) || memcmp(header, elfPrefix, sizeof(elfPrefix)) != 0 ||
+        memcmp(header + 16, rpxTypeAndMachine, sizeof(rpxTypeAndMachine)) != 0) {
+        OSReport("[homebrew dev] Invalid SD RPX header; using bundled executable\n");
+        return {};
+    }
+    const std::string content = "/vol/external01/" + selected.substr(0, selected.rfind('/')) + "/content";
+    const std::string contentFS = "fs:" + content;
+    if (stat(contentFS.c_str(), &info) == 0 && S_ISDIR(info.st_mode)) {
+        if (content.size() >= sizeof(gDevContentPath)) return {};
+        snprintf(gDevContentPath, sizeof(gDevContentPath), "%s", content.c_str());
+    }
+    return selected;
+}
