+static void captureRecorderGamePad(const GX2ColorBuffer *buffer, GX2ScanTarget target) {
+    if (target != GX2_SCAN_TARGET_DRC0 || !buffer || !gEnabled || gBlockScreenshots ||
+        gBlockDRCScreenshots || gTakeScreenshotDRC.state != SCREENSHOT_STATE_READY) return;
+
+    const uint32_t id = gRecorderRequest.exchange(0);
+    if (!id) return;
+
+    OSCalendarTime time;
+    OSTicksToCalendarTime(OSGetTime(), &time);
+    gTakeScreenshotDRC.state = SCREENSHOT_STATE_SAVING;
+    if (!takeScreenshot(const_cast<GX2ColorBuffer *>(buffer), target, gDRCSurfaceFormat,
+                        IMAGE_OUTPUT_FORMAT_PNG, gQuality, time, id)) {
+        gTakeScreenshotDRC.state = SCREENSHOT_STATE_READY;
+    }
+}
