diff --git a/source/mapped_lock_trace.h b/source/mapped_lock_trace.h
new file mode 100644
index 0000000..e423f0f
--- /dev/null
+++ b/source/mapped_lock_trace.h
@@ -0,0 +1,88 @@
+#pragma once
+#include "flight_recorder.h"
+#include <coreinit/spinlock.h>
+#include <function_patcher/function_patching.h>
+// Trace only known mapped heap locks. Never acquire/release a lock on behalf
+// of a caller: these wrappers preserve the original return value and operation.
+static bool traceMappedLock(OSSpinLock *lock) {
+    const auto address = (uint32_t)lock;
+    return address == MEMORY_HEAP0 + 0x20 || address == MEMORY_HEAP1 + 0x20 ||
+           address == MEMORY_HEAP2 + 0x20 || address == MEMORY_HEAP3 + 0x20 ||
+           address == MEMORY_START_VIDEO + 0x20;
+}
+static uint32_t lockEvent(uint32_t event, OSSpinLock *lock, uintptr_t caller, uint32_t token = 0) {
+    return flight::record(event, (uint32_t)caller, (uint32_t)lock,
+                          flight::load(&lock->owner), flight::load(&lock->recursion), token);
+}
+DECL_FUNCTION(BOOL, OSUninterruptibleSpinLock_Acquire, OSSpinLock *lock) {
+    if (!traceMappedLock(lock)) return real_OSUninterruptibleSpinLock_Acquire(lock);
+    const uintptr_t caller = (uintptr_t)__builtin_return_address(0);
+    const uint32_t token = lockEvent(32, lock, caller);
+    const BOOL result = real_OSUninterruptibleSpinLock_Acquire(lock);
+    lockEvent(33, lock, caller, token);
+    return result;
+}
+DECL_FUNCTION(BOOL, OSUninterruptibleSpinLock_Release, OSSpinLock *lock) {
+    if (!traceMappedLock(lock)) return real_OSUninterruptibleSpinLock_Release(lock);
+    const uintptr_t caller = (uintptr_t)__builtin_return_address(0);
+    const uint32_t token = lockEvent(34, lock, caller);
+    const BOOL result = real_OSUninterruptibleSpinLock_Release(lock);
+    lockEvent(35, lock, caller, token);
+    return result;
+}
+DECL_FUNCTION(BOOL, OSAcquireSpinLock, OSSpinLock *lock) {
+    if (!traceMappedLock(lock)) return real_OSAcquireSpinLock(lock);
+    const uintptr_t caller = (uintptr_t)__builtin_return_address(0);
+    const uint32_t token = lockEvent(36, lock, caller);
+    const BOOL result = real_OSAcquireSpinLock(lock);
+    lockEvent(37, lock, caller, token);
+    return result;
+}
+DECL_FUNCTION(BOOL, OSReleaseSpinLock, OSSpinLock *lock) {
+    if (!traceMappedLock(lock)) return real_OSReleaseSpinLock(lock);
+    const uintptr_t caller = (uintptr_t)__builtin_return_address(0);
+    const uint32_t token = lockEvent(38, lock, caller);
+    const BOOL result = real_OSReleaseSpinLock(lock);
+    lockEvent(39, lock, caller, token);
+    return result;
+}
+
