diff --git a/source/flight_recorder.h b/source/flight_recorder.h
new file mode 100644
index 0000000..8acfc17
--- /dev/null
+++ b/source/flight_recorder.h
@@ -0,0 +1,114 @@
+#define FLIGHT_MODULE "MM"
+#pragma once
+// Diagnostic-only recorder. Producers never allocate, print, access files or wait
+// for another core. Only the independent drain thread calls OSReport.
+#include <stdint.h>
+#ifndef FLIGHT_HOST_TEST
+#include <coreinit/core.h>
+#include <coreinit/thread.h>
+#include <coreinit/time.h>
+#include <coreinit/interrupts.h>
+#include <coreinit/debug.h>
+#endif
+namespace flight_mm {
+constexpr uint32_t Capacity = 1024, Words = 10;
+struct alignas(64) Ring { uint32_t head; uint32_t slot[Capacity][Words]; };
+inline Ring rings[3]{};
+inline uint32_t enabled = 0;
+#ifndef FLIGHT_HOST_TEST
+inline OSThread thread;
+#endif
+inline uint32_t load(const uint32_t *p) { return __atomic_load_n(p, __ATOMIC_ACQUIRE); }
+inline void store(uint32_t *p, uint32_t v) { __atomic_store_n(p, v, __ATOMIC_RELEASE); }
+inline uint32_t record(uint32_t event, uint32_t caller, uint32_t a, uint32_t b, uint32_t c, uint32_t token = 0) {
+    if (!load(&enabled)) return 0;
+    #ifndef FLIGHT_HOST_TEST
+    if (OSGetCurrentThread() == &thread) return 0; // Avoid tracing the drain's own logger activity.
+#endif
+    const auto irq = OSDisableInterrupts();
+    const uint32_t core = OSGetCoreId();
+    if (core > 2) { OSRestoreInterrupts(irq); return 0; }
+    auto &r = rings[core];
+    const uint32_t seq = load(&r.head) + 1;
+    auto *s = r.slot[(seq - 1) % Capacity];
+    store(&s[0], 0); // Invalidate before reusing the slot.
+    const uint64_t tick = OSGetTime();
+    const uint32_t values[Words - 1] = {event, (uint32_t)(uintptr_t)OSGetCurrentThread(),
+        (uint32_t)(tick >> 32), (uint32_t)tick, caller, a, b, c, token};
+    for (unsigned i = 1; i < Words; ++i) store(&s[i], values[i - 1]);
+    store(&s[0], seq);
+    store(&r.head, seq);
+    OSRestoreInterrupts(irq);
+    return (seq & 0x3fffffff) | (core << 30);
+}
+struct Scope {
+    uint32_t token, event, caller, result = 0;
+    Scope(uint32_t e, uintptr_t pc, uint32_t a = 0, uint32_t b = 0, uint32_t c = 0)
+        : event(e), caller((uint32_t)pc) { token = record(e, caller, a, b, c); }
+    ~Scope() { if (token) record(event + 1, caller, result, 0, 0, token); }
+};
+// Reader takes a checked atomic snapshot. Concurrent overwrite is rejected.
+inline bool read(unsigned core, uint32_t seq, uint32_t out[Words]) {
+    auto *s = rings[core].slot[(seq - 1) % Capacity];
+    if (load(&s[0]) != seq) return false;
+    for (unsigned i = 0; i < Words; ++i) out[i] = load(&s[i]);
+    return load(&s[0]) == seq && out[0] == seq;
+}
+#ifndef FLIGHT_HOST_TEST
+alignas(32) inline uint8_t stack[32768];
+inline uint32_t stopRequested = 0;
+inline bool started = false;
+inline int drain(int, void *) {
+    uint32_t cursor[3]{};
+    uint32_t beat = 0;
+    while (!load(&stopRequested)) {
+        for (unsigned core = 0; core < 3; ++core) {
+            const uint32_t head = load(&rings[core].head);
+            if (head - cursor[core] > Capacity) {
+                const uint32_t lost = head - cursor[core] - Capacity;
+                OSReport("[AFR1 " FLIGHT_MODULE "] LOST core=%u count=%u\n", core, lost);
+                cursor[core] = head - Capacity;
+            }
+            // Bounded output to avoid drowning the existing TCP logger.
+            for (unsigned budget = 0; cursor[core] != head && budget < 64; ++budget) {
+                uint32_t out[Words];
+                const uint32_t seq = ++cursor[core];
+                if (!read(core, seq, out)) {
+                    OSReport("[AFR1 " FLIGHT_MODULE "] LOST core=%u seq=%u\n", core, seq);
+                    continue;
+                }
+                OSReport("[AFR1 " FLIGHT_MODULE "] E %u %u %u %08X %08X%08X %08X %08X %08X %08X %08X\n",
+                    core, out[0], out[1], out[2], out[3], out[4], out[5], out[6], out[7], out[8], out[9]);
+            }
+        }
+        if (++beat % 10 == 0) OSReport("[AFR1 " FLIGHT_MODULE "] HEARTBEAT head=%u,%u,%u\n", load(&rings[0].head), load(&rings[1].head), load(&rings[2].head));
+        OSSleepTicks(OSMillisecondsToTicks(100));
+    }
+    return 0;
+}
+inline void start() {
+    if (started) return;
+    store(&stopRequested, 0);
+    for (auto &ring : rings) store(&ring.head, 0);
+    // Static thread and stack: startup does not depend on mapped heap allocation.
+    if (!OSCreateThread(&thread, drain, 0, nullptr, stack + sizeof(stack), sizeof(stack), 20,
+                        OS_THREAD_ATTRIB_AFFINITY_ANY)) {
+        OSReport("[AFR1 " FLIGHT_MODULE "] START_FAILED\n");
+        return;
+    }
+    started = true;
+    store(&enabled, 1);
+    OSReport("[AFR1 " FLIGHT_MODULE "] START capacity=%u event_words=%u\n", Capacity, Words);
+    OSResumeThread(&thread);
+}
+inline void stop() {
+    store(&enabled, 0);
+    if (!started) return;
+    store(&stopRequested, 1);
+    OSJoinThread(&thread, nullptr);
+    started = false;
+    OSReport("[AFR1 " FLIGHT_MODULE "] STOP\n");
+}
+#endif
+} // namespace flight_mm
+namespace flight = flight_mm;
diff --git a/source/mapped_heap_guard.h b/source/mapped_heap_guard.h
new file mode 100644
index 0000000..483c0a7
--- /dev/null
+++ b/source/mapped_heap_guard.h
@@ -0,0 +1,32 @@
+#pragma once
+#include <coreinit/memheap.h>
+#include <coreinit/mutex.h>
+#ifndef MAPPED_HEAP_GUARD_TEST
+#include "memory_mapping.h"
+#endif
+namespace mapped_heap {
+inline OSMutex guards[5];
+inline bool ready = false;
+inline int index(MEMHeapHandle heap) {
+    const uintptr_t address = (uintptr_t)heap;
+    const uintptr_t bases[] = {MEMORY_HEAP0, MEMORY_HEAP1, MEMORY_HEAP2, MEMORY_HEAP3, MEMORY_START_VIDEO};
+    for (int i = 0; i < 5; ++i) if (address == bases[i]) return i;
+    return -1;
+}
+inline void initialize() {
+    if (ready) return;
+    for (auto &guard : guards) OSInitMutex(&guard);
+    ready = true; // Called during single-threaded module initialization, before hooks.
+}
+class Guard {
+    OSMutex *mutex = nullptr;
+public:
+    explicit Guard(MEMHeapHandle heap) {
+        const int i = index(heap);
+        if (ready && i >= 0) { mutex = &guards[i]; OSLockMutex(mutex); }
+    }
+    ~Guard() { if (mutex) OSUnlockMutex(mutex); }
+    Guard(const Guard &) = delete;
+    Guard &operator=(const Guard &) = delete;
+};
+}
